{
  "expo": {
    "name": "Binomo Analytics",
    "slug": "binomo-analytics",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "binomoanalytics",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.binomoanalytics.app"
    },
    "android": {
      "package": "com.binomoanalytics.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://192.168.15.17:3000",
      "router": {},
      "eas": {
        "projectId": "80036798-798c-400b-b8b5-70f62bbf9eae"
      }
    },
    "owner": "saintcode"
  }
}
