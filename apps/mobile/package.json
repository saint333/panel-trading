{
  "name": "@binomo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "echo \"El build nativo se ejecuta con EAS (ver docs/14-apk-android.md)\"",
    "build:apk": "npx --yes eas-cli@latest build --platform android --profile preview",
    "update:preview": "npx --yes eas-cli@latest update --channel preview --environment preview"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "expo-constants": "~18.0.10",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "i18next": "^25.6.0",
    "react": "19.1.0",
    "react-i18next": "^15.7.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "5.9.3"
  }
}
