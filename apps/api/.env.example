# Copiar a apps/api/.env y ajustar. Nunca commitear el .env real.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://binomo:binomo@localhost:5432/binomo?schema=public
LOG_LEVEL=debug
CORS_ORIGINS=
API_VERSION=0.1.0

# Autenticación. En producción estos dos secretos son obligatorios (mínimo 32 y 16 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
IP_HASH_SECRET=dev-only-ip-hash-secret
